# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
.python-version

# ---- Packaging / build ----
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
*.whl
*.deb

# ---- Tool caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---- App runtime configuration ----
# The user config lives in ~/.config/linuxstreamdeck/ (outside the repo),
# but in case someone copies it here:
config.json

# ---- Editors / IDE ----
.idea/
.vscode/
*.swp
*.swo
*~
.\#*
\#*\#

# ---- Operating system ----
.DS_Store
Thumbs.db

# ---- Claude Code ----
# Per-user local settings (permissions, etc.). A shared settings.json,
# if present, is versioned.
.claude/settings.local.json

# ---- Logs / temporary ----
*.log
*.tmp

# NOTE: assets are intentionally NOT ignored
#   linuxstreamdeck/assets/icons/*.ttf, *.json, LICENSE-MDI.txt
#   data/udev/*.rules
# they are part of the project and must be versioned.

# flatpak-builder scratch tree
.flatpak-builder/
